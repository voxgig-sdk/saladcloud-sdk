From ecb63c89d3d0aa4d41bd5a35f4264037896881b9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 29 Sep 2026 00:34:13 +0000
Subject: [PATCH] Drop the Pages deploy job from the generated workflow

With the github-pages edition inactive, docgen generates the
Documentation workflow without the site staging step and the deploy
job. The check job still generates the documentation and runs the
prose checks on every push and pull request.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MGpR2XhxWcDCB2n678tzAR
---
 .github/workflows/docgen.yml | 43 ++----------------------------------
 1 file changed, 2 insertions(+), 41 deletions(-)

diff --git a/.github/workflows/docgen.yml b/.github/workflows/docgen.yml
index f0fbf98..b199e2c 100644
--- a/.github/workflows/docgen.yml
+++ b/.github/workflows/docgen.yml
@@ -38,50 +38,11 @@ jobs:
 
       - name: Check every edition
         run: node .sdk/node_modules/@voxgig/docgen/bin/voxgig-docgen qa
-      - name: Stage generated website
-        id: site
-        run: echo "path=$(node .sdk/node_modules/@voxgig/docgen/bin/voxgig-docgen stage github-pages)" >> "$GITHUB_OUTPUT"
+
       - name: Upload documentation
         uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
         with:
           name: documentation
-          path: ${{ steps.site.outputs.path }}
+          path: ".sdk/doc/qa-manifest.json"
           include-hidden-files: true
-  deploy:
-    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'
-    needs: check
-    runs-on: ubuntu-latest
-    permissions:
-      pages: write
-      id-token: write
-    environment:
-      name: github-pages
-      url: ${{ steps.deployment.outputs.page_url }}
-    steps:
-      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
-        with:
-          name: documentation
-          path: site-source
-      - uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b # v5
-      # actions/upload-pages-artifact is a composite action whose own steps call
-      # actions/upload-artifact@v4 by tag. Organisations that require full-length
-      # SHA pinning reject that nested reference, and the caller cannot pin it.
-      # Inline the two steps it performs so every action resolves to a SHA.
-      - name: Archive the Pages artifact
-        run: |
-          tar \
-            --dereference --hard-dereference \
-            --directory site-source \
-            -cvf "$RUNNER_TEMP/artifact.tar" \
-            --exclude=.git \
-            --exclude=.github \
-            .
-      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
-        with:
-          name: github-pages
-          path: ${{ runner.temp }}/artifact.tar
-          retention-days: 1
-          if-no-files-found: error
-      - uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4
-        id: deployment
 
-- 
