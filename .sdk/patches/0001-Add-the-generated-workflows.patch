+# provenance automatically.
+#
+# SET UP ONCE, by a maintainer with publish rights — see .sdk/PUBLISHING.md:
+#
+#   npm trust github @voxgig-sdk/saladcloud-sdk \
+#     --repository voxgig-sdk/saladcloud-sdk \
+#     --file publish-ts.yml \
+#     --allow-publish
+#
