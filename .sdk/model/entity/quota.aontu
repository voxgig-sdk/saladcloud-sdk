# Entity: quota

main: kit: entity: quota: {

  alias: field: {}

  fields: {
    container_replicas_quota: {
      fo: "int32"
      h: "Container Replicas Quota"
      n: "container_replicas_quota"
      r: true
      sh: "The maximum number of replicas that can be created for a container group"
      t: "`$INTEGER`"
    }
    container_replicas_used: {
      fo: "int32"
      h: "Container Replicas Used"
      n: "container_replicas_used"
      r: true
      sh: "The number of replicas that are currently in use"
      t: "`$INTEGER`"
    }
    max_container_group_reallocations_per_minute: {
      fo: "int32"
      h: "Max Container Group Reallocations Per Minute"
      n: "max_container_group_reallocations_per_minute"
      r: false
      sh: "The maximum number of container group reallocations per minute"
      t: "`$INTEGER`"
    }
    max_container_group_recreates_per_minute: {
      fo: "int32"
      h: "Max Container Group Recreates Per Minute"
      n: "max_container_group_recreates_per_minute"
      r: false
      sh: "The maximum number of container group recreates per minute"
      t: "`$INTEGER`"
    }
    max_container_group_restarts_per_minute: {
      fo: "int32"
      h: "Max Container Group Restarts Per Minute"
      n: "max_container_group_restarts_per_minute"
      r: false
      sh: "The maximum number of container group restarts per minute"
      t: "`$INTEGER`"
    }
  }

  name: "quota"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /organizations/{organization_name}/quotas"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "organization_name"
                or: "organization_name"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/organizations/{organization_name}/quotas"
          q: {
            exist: [
              "organization_name"
            ]
          }
          s: [
            {
              lit: "organizations"
            }
            {
              var: "organization_name"
            }
            {
              lit: "quotas"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.container_groups_quotas`"
          }
        }
      ]
    }
  }



}
