      n: "id"
      r: true
      sh: "The container group identifier."
      t: "`$STRING`"
    }
    liveness_probe: {
      h: "Liveness Probe"
      n: "liveness_probe"
      r: true
      sh: "Defines a liveness probe for container groups that determines when to restart a container if it becomes unhealthy"
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The container group name."
      t: "`$STRING`"
    }
    networking: {
      h: "Networking"
      n: "networking"
      r: true
      sh: "Network configuration for container groups that defines connectivity, routing, and access control settings"
      t: "`$OBJECT`"
    }
    organization_name: {
      h: "Organization Name"
      n: "organization_name"
      r: true
      sh: "The organization name."
      t: "`$STRING`"
    }
    pending_change: {
      h: "Pending Change"
      n: "pending_change"
      r: true
      sh: "Indicates whether a configuration change has been requested but not yet applied to all containers in the group"
      t: "`$BOOLEAN`"
    }
    priority: {
      h: "Priority"
      n: "priority"
      r: true
      sh: "Specifies the priority level for container group execution, which determines resource allocation and scheduling precedence."
