        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    project_name: {
      h: "Project Name"
      n: "project_name"
      r: true
      sh: "The project name."
      t: "`$STRING`"
    }
    queue_autoscaler: {
      h: "Queue Autoscaler"
      n: "queue_autoscaler"
      r: true
      sh: "Defines configuration for automatically scaling container instances based on queue length."
      t: "`$OBJECT`"
    }
    queue_connection: {
      h: "Queue Connection"
      n: "queue_connection"
      r: true
