# Entity: container

main: kit: entity: container: {

  alias: field: {}

  fields: {
    autostart_policy: {
      h: "Autostart Policy"
      n: "autostart_policy"
      r: true
      sh: "Defines whether containers in this group should automatically start when deployed (true) or require manual starting (false)"
      t: "`$BOOLEAN`"
    }
    container: {
      h: "Container"
      n: "container"
      r: true
      sh: "Represents a container with its configuration and resource requirements."
      t: "`$OBJECT`"
    }
    country_codes: {
      h: "Country Codes"
      n: "country_codes"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "List of country codes where container instances are permitted to run."
      t: "`$ARRAY`"
    }
    create_time: {
      fo: "date-time"
      h: "Create Time"
      n: "create_time"
      r: true
      sh: "ISO 8601 timestamp when this container group was initially created"
      t: "`$STRING`"
    }
    current_state: {
      h: "Current State"
      n: "current_state"
      r: true
      sh: "Represents the operational state of a container group during its lifecycle, including timing information, status, and instance distribution metrics."
      t: "`$OBJECT`"
    }
