# Entity: gpu_availability

main: kit: entity: gpu_availability: {

  alias: field: {}

  fields: {
    available_gpu_batch: {
      fo: "int32"
      h: "Available Gpu Batch"
      n: "available_gpu_batch"
      r: false
      sh: "The number of available GPU batches"
      t: "`$INTEGER`"
    }
    available_gpu_high: {
      fo: "int32"
      h: "Available Gpu High"
      n: "available_gpu_high"
      r: false
      sh: "The number of available high-end GPUs"
      t: "`$INTEGER`"
    }
    available_gpu_low: {
      fo: "int32"
      h: "Available Gpu Low"
      n: "available_gpu_low"
      r: false
      sh: "The number of available low-end GPUs"
      t: "`$INTEGER`"
    }
    available_gpu_medium: {
      fo: "int32"
      h: "Available Gpu Medium"
      n: "available_gpu_medium"
      r: false
      sh: "The number of available medium-end GPUs"
      t: "`$INTEGER`"
    }
    country_codes: {
      h: "Country Codes"
      n: "country_codes"
      r: false
      sh: "A list of country codes where the resources are available"
      t: "`$ARRAY`"
    }
    cpu: {
      fo: "int32"
      h: "Cpu"
      n: "cpu"
      r: false
      sh: "The number of available CPU cores"
      t: "`$INTEGER`"
    }
    gpu_classes: {
      h: "Gpu Classes"
      n: "gpu_classes"
      r: true
      sh: "A list of available GPU class names"
      t: "`$ARRAY`"
    }
    memory: {
      fo: "int64"
      h: "Memory"
      n: "memory"
      r: false
      sh: "The amount of available memory in MB"
      t: "`$INTEGER`"
    }
    on_call_gpu: {
      fo: "int32"
      h: "On Call Gpu"
      n: "on_call_gpu"
      r: false
      sh: "The number of on-call GPUs available"
      t: "`$INTEGER`"
    }
    storage_amount: {
      fo: "int64"
      h: "Storage Amount"
      n: "storage_amount"
      r: false
      sh: "The amount of available storage in bytes"
      t: "`$INTEGER`"
    }
  }

  name: "gpu_availability"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /organizations/{organization_name}/availability/sce-gpu-availability"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "organization_name"
                or: "organization_name"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/organizations/{organization_name}/availability/sce-gpu-availability"
          q: {
            exist: [
              "organization_name"
            ]
          }
          s: [
            {
              lit: "organizations"
            }
            {
              var: "organization_name"
            }
            {
              lit: "availability"
            }
            {
              lit: "sce-gpu-availability"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
