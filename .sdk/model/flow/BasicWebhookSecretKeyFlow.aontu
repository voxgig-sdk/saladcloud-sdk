# BasicWebhookSecretKeyFlow

main: kit: flow: BasicWebhookSecretKeyFlow:
{
  entity: "webhook_secret_key",
  kind: "basic",
  name: "BasicWebhookSecretKeyFlow",
  step: [
    {
      i: {
        ref: "webhook_secret_key_ref01"
      }

      m: {
        organization_name: "organization_name01"
      }

      o: "create"
    }

    {
      i: {
        ref: "webhook_secret_key_ref01",
        srcdatavar: "webhook_secret_key_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "webhook_secret_key01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-webhook_secret_key_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWebhookSecretKeyFlow"
}